{
  "hosting": {
    "target": "iararchive",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git",
      ".git/**",
      ".github",
      ".github/**",
      ".agents",
      ".agents/**",
      ".firebase",
      ".firebase/**",
      ".venv",
      ".venv/**",
      "__pycache__",
      "__pycache__/**",
      "skills-lock.json",
      "**/node_modules/**",
      "*.py",
      "**/*.py",
      "requirements.txt",
      "migrate_books.py",
      "validate_books.py",
      "COPYRIGHT.md",
      "README.md",
      "*.md",
      "**/*.md",
      "books.json.tmp",
      "h origin main",
      "_headers",
      "pdf",
      "pdf/**",
      "*.tmp",
      "**/*.tmp",
      "*.lock",
      "**/*.lock",
      "*.log",
      "**/*.log",
      ".env",
      ".env.*",
      "package.json",
      "package-lock.json",
      ".DS_Store",
      "Thumbs.db",
      ".vscode",
      ".vscode/**",
      ".idea",
      ".idea/**"
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/manifest.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/books.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/app.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/style.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/covers/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, immutable"
          }
        ]
      },
      {
        "source": "/icons/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, immutable"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, immutable"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
