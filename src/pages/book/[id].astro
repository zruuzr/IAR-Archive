---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeaderPortal from '../../components/bayt-al-hikma/HeaderPortal.astro';
import Colophon from '../../components/editorial/Colophon.astro';
import { getAllBooks, type Book } from '../../lib/books';

export function getStaticPaths() {
  const books = getAllBooks();
  return books.map((book) => ({
    params: { id: String(book.id) },
    props: { book }
  }));
}

interface Props {
  book: Book;
}

const { book } = Astro.props;

// APA Citation
const year = book.year || '2024';
const publisher = book.publisher || 'مستودع المراجع الإدارية العراقية';
const apaCitation = `${book.author}. (${year}). ${book.title}. ${publisher}.`;

// Related books in the same category
const allBooks = getAllBooks();
const relatedBooks = allBooks
  .filter((b) => b.id !== book.id && b.category === book.category)
  .slice(0, 3);
---

<BaseLayout
  title={`${book.title} | مستودع المراجع الإدارية العراقية`}
  description={book.description}
>
  <HeaderPortal />

  <main class="book-detail-container">
    <!-- Breadcrumbs -->
    <nav class="breadcrumbs font-caption" aria-label="مسار التنقل">
      <a href="/" class="crumb-link">الرئيسية</a>
      <span class="crumb-sep">/</span>
      <span class="crumb-category">{book.category}</span>
      <span class="crumb-sep">/</span>
      <span class="crumb-current">{book.title}</span>
    </nav>

    <!-- Main Book Study Dossier -->
    <article class="book-dossier-card">
      <div class="dossier-grid">
        <!-- Cover Column -->
        <div class="dossier-media">
          <div class="cover-box">
            <img
              src={`/${book.cover_image || 'covers/1.png'}`}
              alt={book.title}
              class="dossier-cover-img"
              loading="eager"
            />
          </div>
          <div class="dossier-quick-actions">
            {book.file_path && (
              <a
                href={`/${book.file_path}`}
                class="btn-primary-download font-body-m"
                download
              >
                تحميل المرجع الكامل (PDF)
              </a>
            )}
            <a href="/" class="btn-back-archive font-caption">
              ← العودة للمستودع العام
            </a>
          </div>
        </div>

        <!-- Content Column -->
        <div class="dossier-content">
          <div class="dossier-badge-row">
            <span class="category-pill font-caption">{book.category}</span>
            <span class="year-pill font-mono">{year} مـ</span>
            {book.badge_text && (
              <span class="edition-pill font-caption">{book.badge_text}</span>
            )}
          </div>

          <h1 class="dossier-title">
            {book.title}
          </h1>

          <div class="dossier-author font-heading-m">
            <span>تأليف:</span> <strong>{book.author}</strong>
            {book.publisher && <span class="publisher-tag">({book.publisher})</span>}
          </div>

          <!-- 3-Minute Executive Summary Box -->
          <section class="executive-summary-box">
            <h2 class="box-title font-overline">ملخص الأثر التنفيذي (في 3 دقائق)</h2>
            <p class="box-body font-body-l text-justify">
              {book.description}
            </p>
          </section>

          <!-- Key Study Points -->
          {book.key_points && book.key_points.length > 0 && (
            <section class="key-points-box">
              <h2 class="box-title font-overline">أبرز محاور وأطروحات الدراسة والتحقيق</h2>
              <ul class="points-list font-body-m">
                {book.key_points.map((pt) => (
                  <li>{pt}</li>
                ))}
              </ul>
            </section>
          )}

          <!-- Target Audience -->
          {book.target_audience && (
            <div class="target-audience-note font-caption">
              <strong>الفئة المستهدفة:</strong> {book.target_audience}
            </div>
          )}

          <!-- Structured APA Citation Block -->
          <section class="apa-citation-block">
            <div class="apa-head">
              <span class="font-overline">التوثيق الأكاديمي المعتمد (APA):</span>
              <button
                type="button"
                id="copy-apa-btn"
                class="btn-copy-apa font-caption"
                onclick={`navigator.clipboard.writeText('${apaCitation}'); alert('تم نسخ التوثيق الأكاديمي إلى الحافظة ✓');`}
              >
                نسخ التوثيق
              </button>
            </div>
            <p class="apa-code font-mono">
              {apaCitation}
            </p>
          </section>

          <!-- Technical Metadata Specs -->
          <div class="metadata-matrix font-caption">
            <div class="spec-item">
              <span class="spec-label">عدد الصفحات</span>
              <span class="spec-val font-mono">{book.pages || '—'}</span>
            </div>
            <div class="spec-item">
              <span class="spec-label">حجم الملف</span>
              <span class="spec-val font-mono">{book.file_size || '—'}</span>
            </div>
            <div class="spec-item">
              <span class="spec-label">طبيعة المصنف</span>
              <span class="spec-val">{book.type || 'دليل معتمد'}</span>
            </div>
            <div class="spec-item">
              <span class="spec-label">جهة الإصدار</span>
              <span class="spec-val">{book.publisher || 'خزانة الوثائق العامة'}</span>
            </div>
          </div>
        </div>
      </div>
    </article>

    <!-- Related Books in the same category -->
    {relatedBooks.length > 0 && (
      <section class="related-section">
        <h2 class="related-heading font-heading-m">
          مراجع أخرى في ذات التصنيف ({book.category})
        </h2>
        <div class="related-grid">
          {relatedBooks.map((rel) => (
            <a href={`/book/${rel.id}`} class="related-card">
              <span class="related-cat font-caption">{rel.category}</span>
              <h3 class="related-title font-body-m">{rel.title}</h3>
              <span class="related-author font-caption">{rel.author}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>

  <Colophon />
</BaseLayout>

<style>
  .book-detail-container {
    max-width: 1140px;
    margin-inline: auto;
    padding-inline: var(--s-5);
    padding-bottom: var(--s-10);
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--ink-faint);
    margin-bottom: var(--s-5);
    flex-wrap: wrap;
  }

  .crumb-link {
    color: var(--ink-soft);
    text-decoration: none;
  }

  .crumb-link:hover {
    color: var(--gold-deep);
  }

  .crumb-sep {
    color: var(--gold);
  }

  .crumb-current {
    color: var(--ink);
    font-weight: 600;
  }

  .book-dossier-card {
    background-color: #ffffff;
    border: 1px solid rgba(184, 146, 74, 0.35);
    border-radius: 12px;
    padding: var(--s-7) var(--s-8);
    box-shadow: 0 4px 20px rgba(21, 34, 56, 0.05);
  }

  .dossier-grid {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: var(--s-8);
    align-items: start;
  }

  .dossier-media {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .cover-box {
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 10px 24px rgba(21, 34, 56, 0.16);
    border: 1px solid rgba(184, 146, 74, 0.3);
  }

  .dossier-cover-img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1.42;
    object-fit: cover;
  }

  .dossier-quick-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .btn-primary-download {
    display: block;
    text-align: center;
    background-color: var(--navy-primary);
    color: #ffffff;
    padding: 10px 18px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    transition: background-color var(--transition-fast);
  }

  .btn-primary-download:hover {
    background-color: var(--navy-hover);
  }

  .btn-back-archive {
    display: block;
    text-align: center;
    color: var(--ink-soft);
    text-decoration: none;
    padding: 6px;
  }

  .btn-back-archive:hover {
    color: var(--gold-deep);
  }

  .dossier-content {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    text-align: right;
  }

  .dossier-badge-row {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
  }

  .category-pill {
    background-color: #faf7f0;
    border: 1px solid rgba(184, 146, 74, 0.35);
    padding: 3px 10px;
    border-radius: 4px;
    color: var(--gold-deep);
    font-weight: 600;
  }

  .year-pill {
    background-color: #f0ebe0;
    padding: 3px 8px;
    border-radius: 4px;
    color: var(--ink-soft);
    font-size: 12px;
  }

  .edition-pill {
    background-color: var(--navy-primary);
    color: #ffffff;
    padding: 3px 8px;
    border-radius: 4px;
    font-size: 11px;
  }

  .dossier-title {
    font-family: 'Cairo', var(--font-body);
    font-size: clamp(24px, 2.8vw, 34px);
    font-weight: 800;
    color: var(--ink);
    margin: 0;
    line-height: 1.3;
  }

  .dossier-author {
    color: var(--ink-soft);
    margin: 0;
  }

  .publisher-tag {
    color: var(--ink-faint);
    font-size: 0.9em;
    margin-inline-start: 6px;
  }

  .executive-summary-box,
  .key-points-box {
    background-color: #faf7f0;
    border: 1px solid rgba(184, 146, 74, 0.25);
    border-radius: 6px;
    padding: var(--s-5);
  }

  .box-title {
    color: var(--gold-deep);
    margin: 0 0 var(--s-2) 0;
    font-weight: 700;
  }

  .box-body {
    margin: 0;
    color: var(--ink);
    line-height: 1.7;
  }

  .points-list {
    margin: 0;
    padding-inline-start: var(--s-5);
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .target-audience-note {
    background-color: #f7f4ed;
    border-inline-start: 3px solid var(--gold);
    padding: var(--s-3) var(--s-4);
    color: var(--ink-soft);
  }

  .apa-citation-block {
    background-color: var(--gold-subtle);
    border: 1px dashed var(--gold);
    border-radius: 6px;
    padding: var(--s-4);
  }

  .apa-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--gold-deep);
    font-weight: 700;
  }

  .btn-copy-apa {
    background-color: #ffffff;
    border: 1px solid var(--gold);
    color: var(--ink);
    padding: 3px 10px;
    border-radius: 4px;
    cursor: pointer;
    font-weight: 600;
  }

  .apa-code {
    margin: var(--s-2) 0 0 0;
    direction: ltr;
    text-align: left;
    color: var(--ink);
    font-size: 13px;
  }

  .metadata-matrix {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    background-color: #f8f6f0;
    padding: var(--s-4);
    border-radius: 6px;
    border: 1px solid rgba(184, 146, 74, 0.2);
  }

  .spec-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .spec-label {
    color: var(--ink-faint);
    font-size: 11px;
  }

  .spec-val {
    color: var(--ink);
    font-weight: 600;
  }

  .related-section {
    margin-top: var(--s-9);
  }

  .related-heading {
    color: var(--ink);
    margin-bottom: var(--s-4);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .related-card {
    background-color: #ffffff;
    border: 1px solid rgba(184, 146, 74, 0.3);
    border-radius: 8px;
    padding: 16px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .related-card:hover {
    transform: translateY(-2px);
    border-color: var(--gold);
  }

  .related-cat {
    color: var(--gold-deep);
  }

  .related-title {
    color: var(--ink);
    margin: 0;
    font-weight: 700;
  }

  .related-author {
    color: var(--ink-faint);
  }

  @media (max-width: 900px) {
    .dossier-grid {
      grid-template-columns: 1fr;
    }

    .cover-box {
      max-width: 260px;
      margin: 0 auto;
    }

    .metadata-matrix {
      grid-template-columns: repeat(2, 1fr);
    }

    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
