---
// HeaderPortal.astro — Modern Bayt al-Hikma Architectural Arch Header
---

<header class="portal-header" role="banner">
  <!-- Top Arch Frame -->
  <div class="arch-wrapper">
    <div class="arch-portal-img-container">
      <img
        src="/icons/arch_portal.png"
        alt="قوس دار الحكمة المعاصرة"
        class="arch-portal-img"
        aria-hidden="true"
      />
    </div>

    <!-- Title and Inscriptions under the Arch -->
    <div class="arch-content">
      <h1 class="portal-title">
        مستودع المراجع الإدارية العراقية
      </h1>
      <p class="portal-subtitle font-caption">
        IAR ARCHIVE
      </p>
    </div>
  </div>
</header>

<style>
  .portal-header {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    padding-top: 0;
    margin-bottom: var(--s-5);
  }

  .arch-wrapper {
    position: relative;
    width: 100%;
    max-width: 900px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .arch-portal-img-container {
    width: 100%;
    display: flex;
    justify-content: center;
    overflow: hidden;
  }

  .arch-portal-img {
    width: 100%;
    max-width: 800px;
    height: auto;
    display: block;
    object-fit: contain;
    user-select: none;
    pointer-events: none;
    filter: drop-shadow(0 4px 10px rgba(21, 34, 56, 0.05));
  }

  .arch-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-top: var(--s-1);
    z-index: 2;
  }

  .portal-title {
    font-family: 'Cairo', var(--font-body);
    font-weight: 800;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.25;
    color: var(--ink);
    margin: 0;
    letter-spacing: -0.015em;
  }

  .portal-subtitle {
    font-family: 'IBM Plex Sans Arabic', sans-serif;
    font-weight: 600;
    font-size: clamp(12px, 1.3vw, 14px);
    letter-spacing: 0.38em;
    color: var(--ink);
    margin: var(--s-2) 0 0 0;
    text-transform: uppercase;
    opacity: 0.9;
  }

  @media (max-width: 640px) {
    .portal-title {
      font-size: 22px;
      padding-inline: var(--s-4);
    }

    .portal-subtitle {
      letter-spacing: 0.25em;
      font-size: 11px;
    }

    .arch-portal-img {
      max-width: 100%;
    }
  }
</style>
