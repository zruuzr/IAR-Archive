---
import { getCategoriesWithCounts } from '../../lib/books';

interface Props {
  limit?: number;
}

const { limit = 12 } = Astro.props;

// Sort categories by book count descending, then take top categories
const allCategories = getCategoriesWithCounts().sort((a, b) => b.count - a.count);
const displayedCategories = allCategories.slice(0, limit);
const totalBooks = allCategories.reduce((acc, c) => acc + c.count, 0);
---

<section class="toc-section" id="table-of-contents">
  <!-- Section Title & Ornamental Mast -->
  <div class="toc-header">
    <div class="toc-brand-badge font-overline">
      <span class="font-cuneiform" aria-hidden="true">𒁾</span>
      <span>فهرس الأبواب والمعارف · TABLE OF CONTENTS</span>
      <span class="font-cuneiform" aria-hidden="true">𒁾</span>
    </div>

    <h2 class="font-display-l toc-title">
      أبواب الخزانة العلمية
    </h2>

    <p class="font-body-m toc-intro">
      مفهرسة بحسب المسارات المعرفية المعتمدة في أرشيف دار الحكمة — اختر الباب للانتقال إلى مراججه الموثقة.
    </p>

    <hr class="editorial-rule-thin" />
  </div>

  <!-- Editorial TOC Columns -->
  <div class="toc-grid">
    {displayedCategories.map((cat, idx) => {
      const num = String(idx + 1).padStart(2, '0');
      return (
        <a href={`#category-${encodeURIComponent(cat.name)}`} class="toc-line-item">
          <span class="toc-num font-mono">{num}</span>
          <span class="toc-name font-display-m">{cat.name}</span>
          <span class="toc-dotted-leader" aria-hidden="true"></span>
          <span class="toc-count font-mono">{cat.count} مرجع</span>
        </a>
      );
    })}
  </div>

  <!-- TOC Footer Summary Bar -->
  <div class="toc-footer">
    <div class="toc-summary-item font-caption">
      <span class="font-cuneiform" aria-hidden="true">𒆠</span>
      <span>مجموع الأبواب المصنفة: <strong>{allCategories.length} باباً معرفياً</strong></span>
    </div>
    <span class="toc-sep font-cuneiform" aria-hidden="true">❖</span>
    <div class="toc-summary-item font-caption">
      <span>إجمالي المراجع المرقمنة: <strong>{totalBooks} مجلداً وبحثاً</strong></span>
    </div>
  </div>

  <div class="ornament-divider">
    <span class="ornament-symbol">❖</span>
  </div>
</section>

<style>
  .toc-section {
    width: 100%;
    margin-block: var(--s-10);
    padding: var(--s-8) var(--s-7);
    background-color: var(--paper-surface);
    border: 1px solid var(--gold-line);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
  }

  .toc-header {
    text-align: center;
    max-width: 800px;
    margin-inline: auto;
    margin-bottom: var(--s-6);
  }

  .toc-brand-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--gold-deep);
    margin-bottom: var(--s-2);
  }

  .toc-title {
    color: var(--ink);
    margin-top: var(--s-1);
  }

  .toc-intro {
    color: var(--ink-soft);
    margin-top: var(--s-3);
    margin-bottom: var(--s-4);
  }

  /* Editorial 2-column TOC Grid */
  .toc-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: var(--s-8);
    row-gap: var(--s-4);
    margin-block: var(--s-5);
  }

  .toc-line-item {
    display: flex;
    align-items: baseline;
    text-decoration: none;
    color: var(--ink);
    padding: var(--s-2) var(--s-3);
    border-radius: var(--radius-xs);
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .toc-line-item:hover {
    background-color: var(--gold-subtle);
  }

  .toc-line-item:hover .toc-name {
    color: var(--gold-deep);
  }

  .toc-num {
    font-size: 14px;
    color: var(--gold-deep);
    font-weight: 700;
    min-width: 32px;
  }

  .toc-name {
    font-size: 20px;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 340px;
  }

  /* Classic Magazine Dotted Leader Line */
  .toc-dotted-leader {
    flex-grow: 1;
    border-bottom: 2px dotted var(--gold-line);
    margin-inline: var(--s-3);
    transform: translateY(-4px);
    opacity: 0.75;
  }

  .toc-count {
    font-size: 13px;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  /* TOC Footer Bar */
  .toc-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-5);
    margin-top: var(--s-6);
    padding-top: var(--s-4);
    border-top: 1px solid var(--gold-line);
    color: var(--ink-soft);
  }

  .toc-summary-item {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }

  .toc-sep {
    color: var(--gold);
    font-size: 12px;
  }

  @media (max-width: 900px) {
    .toc-grid {
      grid-template-columns: 1fr;
      row-gap: var(--s-3);
    }
    .toc-section {
      padding: var(--s-6) var(--s-4);
    }
    .toc-name {
      max-width: 220px;
      font-size: 18px;
    }
  }

  @media (max-width: 600px) {
    .toc-footer {
      flex-direction: column;
      gap: var(--s-2);
    }
    .toc-sep {
      display: none;
    }
  }
</style>
