---
import type { Book } from '../../lib/books';

interface Props {
  book: Book;
}

const { book } = Astro.props;
---

<section class="cover-section">
  <!-- Brand & Overline Header -->
  <div class="cover-header">
    <div class="cover-brand-row">
      <span class="font-overline brand-kicker">دار الحكمة المعاصرة · BAYT AL-HIKMA</span>
      <span class="brand-crest font-cuneiform" aria-hidden="true">𒀭𒈗𒂗</span>
    </div>
    <hr class="editorial-rule-thin" />

    <h1 class="font-display-xl cover-main-title">
      مستودع المراجع الإدارية العراقية
    </h1>

    <div class="cover-subtitle-row">
      <span class="font-overline cover-tagline">
        IAR ARCHIVE · FROM SUMER'S TABLETS TO TODAY'S PAGES
      </span>
      <span class="font-caption cover-issue-date">بغداد · 1448 هـ / 2026 م</span>
    </div>

    <p class="font-body-l text-justify cover-manifesto">
      من ألواح سومر الأولى في أور ولكش إلى دفاتر الإدارة المعاصرة، يُعيد هذا الأرشيف الاعتبار للتقاليد الإدارية العراقية العريقة بوصفها نتاجاً فكرياً متراكماً يستحق التوثيق والتبويب والاحتفاء الأكاديمي.
    </p>
  </div>

  <hr class="editorial-rule" />

  <!-- Asymmetric Editorial Grid: Cover Story + Editor's Note -->
  <div class="editorial-grid cover-layout">
    <!-- Main: Cover Story (Featured Book) -->
    <article class="cover-story-card">
      <div class="cover-story-badge-row">
        <span class="badge-cover-story font-overline">قصة الغلاف · COVER STORY</span>
        <span class="font-caption category-stamp">{book.category || "مرجع إداري"}</span>
      </div>

      <div class="cover-story-body">
        <div class="book-facade-wrapper">
          {book.cover_image ? (
            <img
              src={`/${book.cover_image}`}
              alt={book.title}
              class="editorial-book-cover"
              loading="eager"
            />
          ) : (
            <div class="leather-codex-fallback">
              <div class="codex-gold-filigree"></div>
              <div class="codex-cuneiform-seal font-cuneiform">𒂍𒁾𒁀</div>
              <div class="codex-title font-display-m">{book.title}</div>
              <div class="codex-author font-caption">{book.author}</div>
            </div>
          )}
          <div class="codex-shadow" aria-hidden="true"></div>
        </div>

        <div class="cover-story-content">
          <div class="meta-row font-caption">
            <span class="meta-item">الرقم المرجعي: #{book.id}</span>
            <span class="meta-separator">·</span>
            <span class="meta-item">{book.year || "2026"}</span>
            <span class="meta-separator">·</span>
            <span class="meta-item">{book.pages ? `${book.pages} صفحة` : "مجلد"}</span>
          </div>

          <h2 class="font-display-l book-title">
            <a href={`/book/${book.id}`} class="editorial-link">{book.title}</a>
          </h2>

          <p class="font-body-l book-author-line">
            <em>بقلم: {book.author || "هيئة المراجع الوطنية"}</em>
          </p>

          <p class="font-body-m text-justify book-description drop-cap">
            {book.description}
          </p>

          <div class="rating-strip font-mono">
            <span class="rating-bullets">●●●●○</span>
            <span class="rating-label font-caption">تقييم أكاديمي معتمد</span>
          </div>

          <!-- Editorial Action Bar -->
          <div class="editorial-actions">
            {book.file_path && (
              <a href={`/${book.file_path}`} class="btn-editorial-primary" target="_blank" rel="noopener">
                <span>قراءة المرجع المرقمن</span>
                <span class="btn-arrow" aria-hidden="true">←</span>
              </a>
            )}
            <a href={`/book/${book.id}`} class="btn-editorial-ghost">
              <span>الملخص التحريري (3 دقائق)</span>
            </a>
            <button type="button" class="btn-editorial-cite" data-cite={book.id}>
              <span>توثيق APA</span>
            </button>
          </div>
        </div>
      </div>
    </article>

    <!-- Side: Editor's Note (كلمة المحرر) -->
    <aside class="editors-note-card">
      <div class="note-header">
        <span class="font-overline note-kicker">كلمة العدد · EDITOR'S NOTE</span>
        <h3 class="font-heading-l note-title">في استعادة روح التدوين</h3>
      </div>

      <div class="editorial-rule-thin"></div>

      <div class="font-body-m note-body text-justify">
        <p>
          حين نقرأ في ألواح بابل وسومر، ندرك أن التنظيم لم يكن مجرد بيروقراطية جامدة، بل كان فناً لضبط المدينة وإعلاء شأن المعرفة.
        </p>
        <p style="margin-top: var(--s-3);">
          تأتي هذه المنصة لتجمع بين رصانة الورق التاريخي وحرية النشر الرقمي، واضعة بين يدي الباحث العربي زبدة الفكر الإداري والتنظيمي المعاصر.
        </p>
      </div>

      <div class="note-ornament font-cuneiform" aria-hidden="true">
        ❖ 𒂍 · 𒀭 ❖
      </div>

      <div class="note-footer font-caption">
        <strong>هيئة التحرير الأكاديمية</strong>
        <span>بغداد · دار الحكمة</span>
      </div>
    </aside>
  </div>
</section>

<style>
  .cover-section {
    width: 100%;
    margin-bottom: var(--s-10);
  }

  .cover-header {
    max-width: 980px;
    margin-inline: auto;
    text-align: center;
    padding-top: var(--s-6);
  }

  .cover-brand-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-3);
  }

  .brand-kicker {
    color: var(--gold-deep);
    letter-spacing: 0.12em;
  }

  .brand-crest {
    color: var(--gold);
    font-size: 16px;
  }

  .cover-main-title {
    margin-top: var(--s-4);
    color: var(--ink);
  }

  .cover-subtitle-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-4);
    margin-top: var(--s-3);
    color: var(--ink-soft);
  }

  .cover-tagline {
    color: var(--gold-deep);
  }

  .cover-manifesto {
    margin-top: var(--s-5);
    margin-inline: auto;
    max-width: 820px;
    color: var(--ink-soft);
    line-height: 1.75;
  }

  /* Asymmetric 12-column layout */
  .cover-layout {
    margin-top: var(--s-7);
    align-items: start;
  }

  /* Main Cover Story (Columns 1-8) */
  .cover-story-card {
    grid-column: span 8;
    background-color: var(--paper-surface);
    border: 1px solid var(--gold-line);
    padding: var(--s-6);
    border-radius: var(--radius-sm);
    position: relative;
    box-shadow: var(--shadow-md);
  }

  .cover-story-badge-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--s-5);
    border-bottom: 1px solid var(--gold-line);
    padding-bottom: var(--s-2);
  }

  .badge-cover-story {
    color: var(--gold-deep);
    font-weight: 700;
  }

  .category-stamp {
    color: var(--ink-soft);
    background-color: var(--gold-subtle);
    padding: 2px 8px;
    border-radius: var(--radius-xs);
  }

  .cover-story-body {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: var(--s-6);
    align-items: start;
  }

  .book-facade-wrapper {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .editorial-book-cover {
    width: 100%;
    max-width: 260px;
    height: auto;
    aspect-ratio: 1 / 1.45;
    object-fit: cover;
    border-radius: var(--radius-xs);
    box-shadow: var(--shadow-book);
    border: 1px solid rgba(26, 31, 46, 0.1);
  }

  .codex-shadow {
    position: absolute;
    bottom: -12px;
    left: 5%;
    width: 90%;
    height: 16px;
    background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.35) 0%, transparent 70%);
    z-index: -1;
  }

  .cover-story-content {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .meta-row {
    color: var(--ink-soft);
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }

  .book-title {
    color: var(--ink);
    margin-top: 2px;
  }

  .book-author-line {
    color: var(--ink-soft);
    margin-bottom: var(--s-2);
  }

  .book-description {
    color: var(--ink);
    line-height: 1.7;
  }

  .rating-strip {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }

  .rating-bullets {
    color: var(--gold-deep);
    letter-spacing: 0.15em;
  }

  .rating-label {
    color: var(--ink-soft);
  }

  .editorial-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
    margin-top: var(--s-5);
    padding-top: var(--s-4);
    border-top: 1px solid var(--gold-line);
  }

  .btn-editorial-primary {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    background-color: var(--ink);
    color: var(--paper);
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--radius-xs);
    transition: background-color var(--transition-fast);
  }

  .btn-editorial-primary:hover {
    background-color: var(--gold-deep);
  }

  .btn-editorial-ghost {
    display: inline-flex;
    align-items: center;
    color: var(--ink);
    padding: 10px 16px;
    font-size: 14px;
    text-decoration: none;
    border: 1px solid var(--gold-line);
    border-radius: var(--radius-xs);
    background-color: transparent;
    transition: background-color var(--transition-fast);
  }

  .btn-editorial-ghost:hover {
    background-color: var(--gold-subtle);
  }

  .btn-editorial-cite {
    background: transparent;
    border: none;
    color: var(--gold-deep);
    font-family: var(--font-mono);
    font-size: 13px;
    cursor: pointer;
    text-decoration: underline;
    padding: 4px 8px;
  }

  /* Side: Editor's Note (Columns 9-12) */
  .editors-note-card {
    grid-column: span 4;
    background-color: var(--paper-deep);
    border: 1px solid var(--gold-line);
    padding: var(--s-6);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
    position: relative;
  }

  .note-kicker {
    color: var(--gold-deep);
    display: block;
    margin-bottom: var(--s-2);
  }

  .note-title {
    color: var(--ink);
  }

  .note-body {
    color: var(--ink);
    line-height: 1.7;
    margin-top: var(--s-3);
  }

  .note-ornament {
    text-align: center;
    margin-block: var(--s-5);
    color: var(--gold);
    font-size: 14px;
  }

  .note-footer {
    display: flex;
    flex-direction: column;
    color: var(--ink-soft);
    border-top: 1px solid var(--gold-line);
    padding-top: var(--s-3);
  }

  @media (max-width: 1024px) {
    .cover-story-card {
      grid-column: span 8;
    }
    .editors-note-card {
      grid-column: span 8;
    }
  }

  @media (max-width: 768px) {
    .cover-story-body {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .meta-row, .rating-strip, .editorial-actions {
      justify-content: center;
    }
    .editorial-book-cover {
      max-width: 200px;
    }
  }
</style>
