---
interface Props {
  quote: string;
  attribution?: string;
}

const { quote, attribution } = Astro.props;
---

<figure class="pull-quote">
  <blockquote class="pull-quote-text font-display-m">
    «{quote}»
  </blockquote>
  {attribution && (
    <figcaption class="pull-quote-attribution font-caption">
      — {attribution}
    </figcaption>
  )}
</figure>

<style>
  .pull-quote {
    position: relative;
    margin-block: var(--s-5);
    padding: var(--s-5) var(--s-6);
    border-inline-start: 4px solid var(--gold);
    background-color: var(--gold-subtle);
    border-radius: var(--radius-xs);
  }

  .pull-quote-text {
    color: var(--ink);
    line-height: 1.45;
    font-weight: 400;
  }

  .pull-quote-attribution {
    display: block;
    margin-top: var(--s-3);
    color: var(--ink-soft);
    letter-spacing: 0.04em;
  }
</style>
