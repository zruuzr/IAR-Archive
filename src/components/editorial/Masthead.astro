---
interface Props {
  issueNumber?: string;
  dateHijri?: string;
  location?: string;
}

const {
  issueNumber = "العدد 001 · ISSUE 001",
  dateHijri = "محرم 1448 هـ · 2026 م",
  location = "بغداد · دار الحكمة · BAGHDAD"
} = Astro.props;
---

<header class="masthead-bar">
  <div class="editorial-container masthead-inner">
    <div class="masthead-meta-left">
      <span class="font-overline masthead-pill">{issueNumber}</span>
      <span class="masthead-separator" aria-hidden="true">·</span>
      <span class="font-overline">{dateHijri}</span>
    </div>

    <div class="masthead-brand-center">
      <span class="font-cuneiform masthead-cuneiform" title="دار الحكمة الرافدينية">𒂍𒁾𒁀 · 𒆠𒂗𒂠</span>
    </div>

    <div class="masthead-meta-right">
      <span class="font-overline">{location}</span>
    </div>
  </div>
</header>

<style>
  .masthead-bar {
    width: 100%;
    border-bottom: 1px solid var(--gold-line);
    background-color: var(--paper-surface);
    padding-block: var(--s-2);
    position: relative;
    z-index: 10;
  }

  .masthead-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
  }

  .masthead-meta-left,
  .masthead-meta-right {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--ink-soft);
  }

  .masthead-pill {
    color: var(--gold-deep);
    font-weight: 700;
  }

  .masthead-separator {
    color: var(--gold);
    opacity: 0.6;
  }

  .masthead-brand-center {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .masthead-cuneiform {
    font-size: 13px;
    letter-spacing: 0.15em;
    color: var(--gold);
    opacity: 0.85;
  }

  @media (max-width: 768px) {
    .masthead-inner {
      flex-direction: column;
      text-align: center;
      gap: var(--s-1);
    }

    .masthead-brand-center {
      display: none;
    }
  }
</style>
