---
import type { Book } from '../../lib/books';
import OrnamentDivider from './OrnamentDivider.astro';
import PullQuote from './PullQuote.astro';

interface Props {
  book: Book;
  pattern?: 'split' | 'panoramic' | 'quote';
  reverse?: boolean;
  issueLabel?: string;
}

const {
  book,
  pattern = 'split',
  reverse = false,
  issueLabel = 'مجلد تحليلي'
} = Astro.props;

// APA Citation calculation
const currentYear = book.year || '2026';
const apaCitation = `${book.author}. (${currentYear}). ${book.title}. ${book.publisher || 'مستودع المراجع الإدارية العراقية'}.`;

// Format file size / pages
const metaBadges = [
  book.pages ? `${book.pages} صفحة` : null,
  book.file_size ? `${book.file_size}` : null,
  book.type || 'وثيقة إدارية'
].filter(Boolean);
---

<article class={`book-article pattern-${pattern} ${reverse ? 'is-reversed' : ''}`} id={`book-${book.id}`}>
  {pattern === 'split' && (
    <div class="split-layout">
      <!-- Cover Column (5 cols) -->
      <div class="split-media">
        <a href={`/book/${book.id}`} class="cover-wrapper" title={`تصفح دراسة: ${book.title}`}>
          <div class="cover-frame">
            <img
              src={`/${book.cover_image || 'covers/1.png'}`}
              alt={book.title}
              class="book-cover-img"
              loading="lazy"
              decoding="async"
            />
            <div class="book-spine-sheen" aria-hidden="true"></div>
          </div>
          {book.badge_text && (
            <span class="editorial-badge font-overline">{book.badge_text}</span>
          )}
        </a>
      </div>

      <!-- Text & Marginalia Column (7 cols) -->
      <div class="split-content">
        <div class="article-meta">
          <span class="font-overline issue-label">{issueLabel} · رقم {book.id}</span>
          <span class="meta-dot">·</span>
          <span class="font-overline category-tag">{book.category}</span>
          {book.year && (
            <>
              <span class="meta-dot">·</span>
              <span class="font-overline year-tag">{book.year} مـ</span>
            </>
          )}
        </div>

        <h3 class="article-title font-display-l">
          <a href={`/book/${book.id}`} class="editorial-link">{book.title}</a>
        </h3>

        <div class="article-author font-heading-m">
          <span>تأليف:</span> <strong>{book.author}</strong>
          {book.publisher && <span class="publisher-info">({book.publisher})</span>}
        </div>

        <div class="article-description font-body-l text-justify drop-cap">
          {book.description}
        </div>

        {book.key_points && book.key_points.length > 0 && (
          <div class="marginalia-box">
            <h4 class="marginalia-title font-overline">أبرز محاور الدراسة والتحقيق</h4>
            <ul class="marginalia-list font-body-m">
              {book.key_points.slice(0, 3).map((pt) => (
                <li>{pt}</li>
              ))}
            </ul>
          </div>
        )}

        <div class="apa-teaser font-caption">
          <span class="apa-tag font-overline">التوثيق الأكاديمي (APA):</span>
          <span class="apa-text">{apaCitation}</span>
        </div>

        <div class="article-footer">
          <div class="meta-pill-group font-caption">
            {metaBadges.map((badge) => (
              <span class="meta-pill">{badge}</span>
            ))}
          </div>

          <div class="action-buttons">
            <a href={`/book/${book.id}`} class="btn-read font-body-m">
              <span>قراءة الأثر</span>
              <span class="btn-arrow" aria-hidden="true">←</span>
            </a>
            {book.file_path && (
              <a href={`/${book.file_path}`} class="btn-download font-caption" download>
                تحميل PDF ({book.file_size || 'نسخة أصلية'})
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  )}

  {pattern === 'panoramic' && (
    <div class="panoramic-layout">
      <!-- Panoramic Banner Header -->
      <div class="panoramic-header">
        <div class="panoramic-pretitle font-overline">
          <span>{issueLabel} · مستند مرجعي استثنائي</span>
          <span class="insignia-sign font-cuneiform">𒀭 𒂗 𒆤</span>
        </div>
        <h3 class="panoramic-title font-display-xl">
          <a href={`/book/${book.id}`} class="editorial-link">{book.title}</a>
        </h3>
        <p class="panoramic-author font-heading-m">
          بحث وتحقيق: <strong>{book.author}</strong> — {book.publisher || 'خزانة الوثائق العامة'} ({book.year || '2026'})
        </p>
      </div>

      <div class="panoramic-body">
        <div class="panoramic-text-col">
          {book.key_points && book.key_points[0] && (
            <PullQuote
              quote={book.key_points[0]}
              attribution={`${book.author} — ${book.title}`}
            />
          )}

          <div class="font-body-l text-justify drop-cap panoramic-description">
            {book.description}
          </div>

          {book.target_audience && (
            <div class="audience-note font-caption">
              <strong>الفئة المستهدفة:</strong> {book.target_audience}
            </div>
          )}

          <div class="panoramic-actions">
            <a href={`/book/${book.id}`} class="btn-read primary font-body-m">
              مطالعة الدراسة التفصيلية
            </a>
            {book.file_path && (
              <a href={`/${book.file_path}`} class="btn-download font-body-m" download>
                تحميل الوثيقة الكاملة ({book.file_size || 'PDF'})
              </a>
            )}
            <div class="panoramic-meta font-caption">
              <span>{book.pages} صفحة مُحققة</span> · <span>تصنيف: {book.category}</span>
            </div>
          </div>
        </div>

        <div class="panoramic-media-col">
          <a href={`/book/${book.id}`} class="panoramic-cover-link">
            <div class="panoramic-cover-shadow">
              <img
                src={`/${book.cover_image || 'covers/1.png'}`}
                alt={book.title}
                class="panoramic-cover-img"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="panoramic-seal font-overline">
              <span>طبعة معتمدة</span>
              <span class="seal-year">{book.year || '2026'}</span>
            </div>
          </a>
        </div>
      </div>
    </div>
  )}

  {pattern === 'quote' && (
    <div class="quote-layout">
      <!-- Big Quote Primacy Section -->
      <div class="quote-primary-col">
        <div class="quote-label font-overline">شاهد من الأثر المرجعي</div>
        <blockquote class="lead-quote font-display-l">
          «{book.key_points && book.key_points[0] ? book.key_points[0] : book.description}»
        </blockquote>
        <div class="quote-cite font-caption">
          — مقتطف من كتاب <strong>«{book.title}»</strong> للأستاذ <strong>{book.author}</strong>
        </div>

        <p class="quote-summary font-body-l text-justify">
          {book.description}
        </p>

        <div class="quote-actions">
          <a href={`/book/${book.id}`} class="editorial-link font-heading-m">
            استعراض المرجع والملخص التنفيذي ←
          </a>
        </div>
      </div>

      <!-- Compact Side Dossier Card -->
      <aside class="quote-side-card">
        <div class="side-card-inner">
          <div class="side-cover-box">
            <img
              src={`/${book.cover_image || 'covers/1.png'}`}
              alt={book.title}
              class="side-cover-img"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="side-card-meta">
            <div class="font-overline side-category">{book.category}</div>
            <h4 class="font-heading-m side-title">{book.title}</h4>
            <div class="font-caption side-author">{book.author}</div>
            <div class="side-specs font-caption">
              <span>{book.year || '2026'}</span> · <span>{book.pages || '—'} ص</span> · <span>{book.file_size || 'PDF'}</span>
            </div>
            {book.file_path && (
              <a href={`/${book.file_path}`} class="btn-side-download font-caption" download>
                تحميل المرجع
              </a>
            )}
          </div>
        </div>
      </aside>
    </div>
  )}

  <OrnamentDivider symbol="❖" />
</article>

<style>
  .book-article {
    margin-block-end: var(--s-10);
    position: relative;
  }

  /* --------------------------------------------------------------------------
     Pattern A: Split Layout (5 cols media / 7 cols text)
     -------------------------------------------------------------------------- */
  .split-layout {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--s-8);
    align-items: start;
  }

  .book-article.is-reversed .split-layout {
    grid-template-columns: 7fr 5fr;
  }

  .book-article.is-reversed .split-media {
    order: 2;
  }

  .book-article.is-reversed .split-content {
    order: 1;
  }

  .split-media {
    position: relative;
  }

  .cover-wrapper {
    display: block;
    position: relative;
    text-decoration: none;
    transition: transform var(--transition-normal);
  }

  .cover-wrapper:hover {
    transform: translateY(-4px) scale(1.01);
  }

  .cover-frame {
    position: relative;
    background-color: var(--paper-surface);
    border: 1px solid var(--gold-line);
    border-radius: var(--radius-sm);
    padding: var(--s-3);
    box-shadow: var(--shadow-book);
    overflow: hidden;
  }

  .book-cover-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1.42;
    object-fit: cover;
    border-radius: var(--radius-xs);
  }

  .book-spine-sheen {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.18) 0%,
      rgba(255, 255, 255, 0.04) 4%,
      transparent 8%,
      transparent 94%,
      rgba(0, 0, 0, 0.12) 100%
    );
  }

  .editorial-badge {
    position: absolute;
    top: var(--s-4);
    right: var(--s-4);
    background-color: var(--gold-deep);
    color: #fff;
    padding: 3px 10px;
    border-radius: var(--radius-xs);
    box-shadow: var(--shadow-sm);
  }

  .split-content {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--ink-soft);
  }

  .issue-label {
    color: var(--gold-deep);
    font-weight: 700;
  }

  .meta-dot {
    color: var(--gold);
  }

  .article-title {
    color: var(--ink);
    margin: 0;
  }

  .article-title a {
    color: var(--ink);
    text-decoration: none;
  }

  .article-author {
    color: var(--ink-soft);
  }

  .article-author strong {
    color: var(--ink);
  }

  .publisher-info {
    font-size: 0.9em;
    color: var(--ink-faint);
    margin-inline-start: var(--s-2);
  }

  .article-description {
    color: var(--ink);
    line-height: 1.7;
  }

  .marginalia-box {
    margin-top: var(--s-2);
    padding: var(--s-4) var(--s-5);
    background-color: var(--paper-deep);
    border-inline-start: 3px solid var(--gold);
    border-radius: var(--radius-xs);
  }

  .marginalia-title {
    color: var(--gold-deep);
    margin-bottom: var(--s-2);
  }

  .marginalia-list {
    margin: 0;
    padding-inline-start: var(--s-5);
    color: var(--ink-soft);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .apa-teaser {
    margin-top: var(--s-2);
    padding: var(--s-3) var(--s-4);
    background-color: var(--gold-subtle);
    border: 1px dashed var(--gold-line);
    border-radius: var(--radius-xs);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .apa-tag {
    color: var(--gold-deep);
    font-weight: 700;
  }

  .apa-text {
    color: var(--ink);
    direction: ltr;
    text-align: left;
    font-size: 12px;
  }

  .article-footer {
    margin-top: var(--s-4);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding-top: var(--s-4);
    border-top: 1px solid var(--gold-line);
  }

  .meta-pill-group {
    display: flex;
    gap: var(--s-2);
    flex-wrap: wrap;
  }

  .meta-pill {
    padding: 3px 10px;
    background-color: var(--paper-surface);
    border: 1px solid var(--gold-line);
    color: var(--ink-soft);
    border-radius: var(--radius-xs);
  }

  .action-buttons {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .btn-read {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    background-color: var(--ink);
    color: var(--paper);
    padding: 8px 18px;
    text-decoration: none;
    border-radius: var(--radius-xs);
    font-weight: 500;
    transition: background-color var(--transition-fast), transform var(--transition-fast);
  }

  .btn-read:hover {
    background-color: var(--gold-deep);
    transform: translateY(-1px);
  }

  .btn-arrow {
    transition: transform var(--transition-fast);
  }

  .btn-read:hover .btn-arrow {
    transform: translateX(-4px);
  }

  .btn-download {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--gold);
    transition: color var(--transition-fast);
  }

  .btn-download:hover {
    color: var(--gold-deep);
  }

  /* --------------------------------------------------------------------------
     Pattern B: Panoramic / Full-width Layered
     -------------------------------------------------------------------------- */
  .panoramic-layout {
    background-color: var(--paper-deep);
    border: 1px solid var(--gold-line);
    border-radius: var(--radius-sm);
    padding: var(--s-8) var(--s-8);
    position: relative;
    box-shadow: var(--shadow-sm);
  }

  .panoramic-header {
    border-bottom: 1px solid var(--gold-line);
    padding-bottom: var(--s-5);
    margin-bottom: var(--s-6);
  }

  .panoramic-pretitle {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--gold-deep);
    margin-bottom: var(--s-2);
  }

  .insignia-sign {
    font-size: 16px;
    color: var(--gold);
  }

  .panoramic-title {
    color: var(--ink);
    margin: 0 0 var(--s-2) 0;
  }

  .panoramic-title a {
    color: var(--ink);
    text-decoration: none;
  }

  .panoramic-author {
    color: var(--ink-soft);
    margin: 0;
  }

  .panoramic-body {
    display: grid;
    grid-template-columns: 8fr 4fr;
    gap: var(--s-8);
    align-items: center;
  }

  .panoramic-text-col {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .panoramic-description {
    color: var(--ink);
    line-height: 1.7;
  }

  .audience-note {
    background-color: var(--paper-surface);
    padding: var(--s-3) var(--s-4);
    border-inline-start: 2px solid var(--gold-deep);
    color: var(--ink-soft);
  }

  .panoramic-actions {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    flex-wrap: wrap;
    margin-top: var(--s-4);
  }

  .btn-read.primary {
    background-color: var(--gold-deep);
    color: #fff;
    padding: 10px 22px;
  }

  .btn-read.primary:hover {
    background-color: var(--ink);
  }

  .panoramic-meta {
    color: var(--ink-faint);
  }

  .panoramic-media-col {
    position: relative;
  }

  .panoramic-cover-link {
    display: block;
    position: relative;
    text-decoration: none;
    transform: perspective(1000px) rotateY(-4deg);
    transition: transform var(--transition-normal);
  }

  .panoramic-cover-link:hover {
    transform: perspective(1000px) rotateY(0deg) translateY(-4px);
  }

  .panoramic-cover-shadow {
    box-shadow: -12px 16px 32px rgba(26, 31, 46, 0.28);
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 2px solid var(--gold);
  }

  .panoramic-cover-img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1.42;
    object-fit: cover;
  }

  .panoramic-seal {
    position: absolute;
    bottom: -16px;
    left: 20px;
    background-color: var(--ink);
    color: var(--gold-bright);
    border: 1px solid var(--gold);
    padding: 6px 12px;
    border-radius: var(--radius-xs);
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: 10px;
    box-shadow: var(--shadow-md);
  }

  .seal-year {
    font-weight: 700;
    color: #fff;
  }

  /* --------------------------------------------------------------------------
     Pattern C: Quote Primacy
     -------------------------------------------------------------------------- */
  .quote-layout {
    display: grid;
    grid-template-columns: 8fr 4fr;
    gap: var(--s-8);
    align-items: stretch;
    background-color: var(--paper-surface);
    border: 1px solid var(--gold-line);
    border-radius: var(--radius-sm);
    padding: var(--s-8);
  }

  .quote-primary-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--s-4);
    border-inline-end: 1px solid var(--gold-line);
    padding-inline-end: var(--s-8);
  }

  .quote-label {
    color: var(--gold-deep);
  }

  .lead-quote {
    color: var(--ink);
    margin: 0;
    line-height: 1.35;
    font-style: italic;
    position: relative;
  }

  .quote-cite {
    color: var(--ink-soft);
  }

  .quote-summary {
    color: var(--ink-soft);
    line-height: 1.65;
  }

  .quote-actions {
    margin-top: var(--s-3);
  }

  .quote-side-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .side-card-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--s-3);
  }

  .side-cover-box {
    width: 140px;
    box-shadow: var(--shadow-book);
    border-radius: var(--radius-xs);
    overflow: hidden;
    border: 1px solid var(--gold-line);
  }

  .side-cover-img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1.42;
    object-fit: cover;
  }

  .side-category {
    color: var(--gold-deep);
    margin-bottom: 2px;
  }

  .side-title {
    color: var(--ink);
    margin: 0;
  }

  .side-author {
    color: var(--ink-soft);
  }

  .side-specs {
    color: var(--ink-faint);
    margin-top: var(--s-1);
  }

  .btn-side-download {
    display: inline-block;
    margin-top: var(--s-3);
    padding: 6px 14px;
    background-color: var(--paper-deep);
    border: 1px solid var(--gold);
    color: var(--ink);
    text-decoration: none;
    border-radius: var(--radius-xs);
    transition: all var(--transition-fast);
  }

  .btn-side-download:hover {
    background-color: var(--gold);
    color: #fff;
  }

  /* Responsive Breakpoints */
  @media (max-width: 900px) {
    .split-layout,
    .book-article.is-reversed .split-layout,
    .panoramic-body,
    .quote-layout {
      grid-template-columns: 1fr;
      gap: var(--s-6);
    }

    .book-article.is-reversed .split-media {
      order: 1;
    }

    .book-article.is-reversed .split-content {
      order: 2;
    }

    .quote-primary-col {
      border-inline-end: none;
      border-bottom: 1px solid var(--gold-line);
      padding-inline-end: 0;
      padding-bottom: var(--s-6);
    }

    .panoramic-layout {
      padding: var(--s-5);
    }

    .panoramic-cover-link {
      transform: none;
      max-width: 260px;
      margin: 0 auto;
    }
  }
</style>
