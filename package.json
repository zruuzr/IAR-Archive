{
  "name": "iar-archive",
  "version": "1.0.0",
  "private": true,
  "description": "IAR Archive — E2E tests and development tooling (application is Vanilla JS, no build step)",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "install:browsers": "playwright install --with-deps chromium"

    "lint": "eslint js/ app.js",
    "lint:fix": "eslint js/ app.js --fix",
    "format": "prettier --write \"js/**/*.js\" \"app.js\"",
    "format:check": "prettier --check \"js/**/*.js\" \"app.js\"",
    "check": "npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
