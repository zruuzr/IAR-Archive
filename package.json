{
  "name": "iar-archive",
  "version": "1.0.0",
  "private": true,
  "description": "IAR Archive — Modern Bayt al-Hikma Editorial digital repository (Astro 5 + Svelte)",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && cp -f dist/index.html dist/sw.js dist/registerSW.js dist/manifest.webmanifest dist/workbox-*.js . && rm -rf _astro book && cp -r dist/_astro dist/book .",
    "preview": "astro preview",
    "astro": "astro",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "install:browsers": "playwright install --with-deps chromium",
    "lint": "eslint js/ app.js",
    "lint:fix": "eslint js/ app.js --fix",
    "format": "prettier --write \"js/**/*.js\" \"app.js\"",
    "format:check": "prettier --check \"js/**/*.js\" \"app.js\"",
    "check": "npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@astrojs/svelte": "^7.2.5",
    "@vite-pwa/astro": "^1.2.0",
    "astro": "^5.18.2",
    "svelte": "^5.57.2",
    "typescript": "^5.9.3"
  }
}
